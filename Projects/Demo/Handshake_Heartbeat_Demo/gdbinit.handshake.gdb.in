set pagination off
set confirm off
set remotetimeout 20

# =============================================================================
# S300 Handshake & Heartbeat Demo - GDB 初始化脚本 (带 DSP 加载)
# =============================================================================
# 
# 此脚本会：
#   1. 让 DSP 保持域复位
#   2. 加载 DSP bin 到 PTCM/DTCM
#   3. 加载 CM4 程序到 SRAM
#   4. 释放 DSP 域复位
#   5. 启动 CM4 程序
#
# 生成方式: CMake 自动从此模板生成
# =============================================================================

# 选择 Cortex-M4 核心
monitor targets ne005.m4

# 停止 + 软复位
monitor halt
monitor soft_reset_halt
monitor wait_halt 2000

# ---------------------------------------------------------------------------
# Step 1: 让 DSP 保持域复位状态
# DSP_CEVA_RST_CTRL (0x4000a018) = 0
# ---------------------------------------------------------------------------
echo \n>>> Holding DSP in domain reset...\n
set {unsigned int}0x4000a018 = 0
monitor sleep 50

# ---------------------------------------------------------------------------
# Step 2: 加载 DSP bin 文件到 PTCM/DTCM
# ---------------------------------------------------------------------------
echo \n>>> Loading DSP binary files...\n
@GDB_RESTORE_DTCM@
@GDB_RESTORE_PTCM@

# ---------------------------------------------------------------------------
# Step 3: 加载 CM4 程序到 SRAM
# ---------------------------------------------------------------------------
echo \n>>> Loading CM4 program...\n
load

# 设置 SRAM 向量表
set $sp = *(unsigned int*)0x20000000
set $pc = *(unsigned int*)0x20000004
set {unsigned int}0xE000ED08 = 0x20000000

# ---------------------------------------------------------------------------
# Step 4: 释放 DSP 域复位
# 注意: DSP 域复位/解复位由 GDB 负责，CM4 代码不再控制 DSP_CEVA_RST_CTRL
# ---------------------------------------------------------------------------
echo \n>>> Releasing DSP domain reset...\n
set {unsigned int}0x4000a018 = 1

# ---------------------------------------------------------------------------
# Step 5: 启动 CM4 程序
# ---------------------------------------------------------------------------
echo \n>>> Starting CM4 program...\n
echo >>> DSP bin loaded and domain reset released\n
continue
